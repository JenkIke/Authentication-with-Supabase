# Copy this file to `.env` (same folder as package.json) and fill in your values.
# Find them in the Supabase dashboard: Project Settings -> API Keys / Data API.
# `.env` is gitignored -- never commit your real values.
# Expo only exposes variables that start with EXPO_PUBLIC_ to the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
